# PostgreSQL
POSTGRES_USER=ride
POSTGRES_PASSWORD=ride_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=ride-dispatch

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1h

# gRPC
USER_SERVICE_GRPC_URL=user-service:50051
DRIVER_SERVICE_GRPC_URL=driver-service:50052
TRIP_SERVICE_GRPC_URL=trip-service:50053

# Ports
API_GATEWAY_PORT=3000

# Database URLs
USER_SERVICE_DATABASE_URL=postgresql://ride:ride_pass@user-db:5432/user_service
DRIVER_SERVICE_DATABASE_URL=postgresql://ride:ride_pass@driver-db:5432/driver_service
TRIP_SERVICE_DATABASE_URL=postgresql://ride:ride_pass@trip-db:5432/trip_service
NOTIFICATION_SERVICE_DATABASE_URL=postgresql://ride:ride_pass@notification-db:5432/notification_service
