{
  "name": "ride-dispatch",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint 'packages/*/src/**/*.ts' 'services/*/src/**/*.ts'",
    "format": "prettier --write '**/*.ts'",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
